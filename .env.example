# ==============================================================================
# Japan Saathi - Unified Environment Configuration Template
# Copy this file to .env and fill in your Gemini API Key
# ==============================================================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Go Planner Service Port
PORT=8080

# Service URLs
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Amadeus Flight API Credentials (Optional - uses calibrated real matrix if omitted)
# Register for free at: https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
